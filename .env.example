OPENSCOUT_ENV=local
OPENSCOUT_API_HOST=0.0.0.0
OPENSCOUT_API_PORT=8000
OPENSCOUT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,tauri://localhost,http://tauri.localhost
OPENSCOUT_DATABASE_URL=postgresql+psycopg://openscout:openscout@localhost:5432/openscout
GITHUB_TOKEN=
CRON_SECRET=
OPENSCOUT_GITHUB_API_URL=https://api.github.com
OPENSCOUT_GITHUB_API_VERSION=2026-03-10
OPENAI_API_KEY=
OPENSCOUT_OPENAI_MODEL=gpt-5.6-luna
OPENSCOUT_OPENAI_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
OPENSCOUT_EMBEDDING_MODEL=
OPENSCOUT_EMBEDDING_API_URL=https://api.openai.com/v1
OPENSCOUT_PUBLIC_RATE_LIMIT_PER_MINUTE=120
OPENSCOUT_AGENT_RATE_LIMIT_PER_MINUTE=30
OPENSCOUT_MODEL_INPUT_COST_PER_MILLION=0
OPENSCOUT_MODEL_OUTPUT_COST_PER_MILLION=0
OPENSCOUT_EMBEDDING_COST_PER_MILLION=0
# Fixer agent (issue-to-PR): model defaults to OPENSCOUT_OPENAI_MODEL when unset.
OPENSCOUT_FIXER_MODEL=
OPENSCOUT_FIXER_MAX_ROUNDS=5
OPENSCOUT_FIXER_TOKEN_BUDGET=200000
# Optional configured-rate estimates. Leave unset when prices are unknown.
# OPENSCOUT_FIXER_INPUT_COST_PER_MILLION=<USD per million input tokens>
# OPENSCOUT_FIXER_OUTPUT_COST_PER_MILLION=<USD per million output tokens>
# OPENSCOUT_FIXER_EMBEDDING_COST_PER_MILLION=<USD per million embedding tokens>
# Only enable after confirming an explicitly configured zero price; old placeholder zeros are unknown.
OPENSCOUT_FIXER_ZERO_PRICE_CONFIRMED=false
# Optional persistent receipt directory, outside Agent workspaces.
# OPENSCOUT_AGENT_EVIDENCE_ROOT=<absolute path to a persistent directory>
# Sandbox backend for the fixer agent: local (dev only) or docker.
OPENSCOUT_SANDBOX_BACKEND=local
OPENSCOUT_AGENT_WORKSPACE_ROOT=
